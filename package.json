{
  "name": "fenceline",
  "version": "0.2.0",
  "description": "A gamified monitor that shows what AI coding agents do on your Mac, and flags anything they did without reporting it.",
  "scripts": {
    "start": "node tools/serve.mjs",
    "collector": "node tools/collector.mjs",
    "collector:lite": "node tools/collector.mjs --lite",
    "stop": "pkill -INT -f '^([^ ]*/)?node [^ ]*tools/(collector|serve)[.]mjs' || true",
    "verify-log": "node tools/verify-log.mjs",
    "report": "node tools/report.mjs",
    "install-hooks": "node tools/install-hooks.mjs",
    "uninstall-hooks": "node tools/install-hooks.mjs --uninstall",
    "build": "node tools/build.mjs",
    "validate": "node tools/validate-events.mjs examples/sample-events.jsonl examples/replays/*.jsonl",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\"",
    "bench": "npm run build && node tools/bench.mjs dist/fenceline.html",
    "generate": "node tools/generate-events.mjs",
    "media": "npm run build && node tools/capture-media.mjs"
  },
  "keywords": [
    "ai-agents",
    "observability",
    "security",
    "claude-code",
    "copilot",
    "macos",
    "visualisation"
  ],
  "author": "Kayode",
  "license": "MIT",
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
